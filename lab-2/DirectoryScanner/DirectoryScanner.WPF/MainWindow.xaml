<Window x:Class="DirectoryScanner.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DirectoryScanner.Core.Models;assembly=DirectoryScanner.Core"
        xmlns:vm="clr-namespace:DirectoryScanner.WPF.ViewModels"
        Title="Directory Scanner" Height="650" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F5F5F7">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#DDD" BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="📁 Выбрать папку" 
                            Command="{Binding StartCommand}" 
                            Padding="20,8" 
                            Background="#007ACC" Foreground="White" BorderThickness="0" 
                            Cursor="Hand" FontWeight="SemiBold"/>

                    <Button Content="Отмена" 
                            Command="{Binding CancelCommand}" 
                            Padding="20,8" Margin="10,0,0,0"
                            Background="#FF5F5F" Foreground="White" BorderThickness="0"
                            Cursor="Hand" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
            <TreeView ItemsSource="{Binding RootNodes}" BorderThickness="0" Margin="5">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type core:DirectoryNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="📁" Margin="0,0,8,0" Foreground="#FFC107"/>
                            <TextBlock Text="{Binding Name}" FontSize="14"/>
                            <TextBlock Text="{Binding Size, StringFormat=' ({0:N0} байт)'}" Foreground="#888" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Percentage, StringFormat=' {0:F1}%'}" Foreground="#007ACC" Margin="10,0,0,0" FontWeight="Bold"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <DataTemplate DataType="{x:Type core:FileNode}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="📄" Margin="0,0,8,0" Foreground="#90A4AE"/>
                            <TextBlock Text="{Binding Name}" FontSize="14"/>
                            <TextBlock Text="{Binding Size, StringFormat=' ({0:N0} байт)'}" Foreground="#888" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Percentage, StringFormat=' {0:F1}%'}" Foreground="#4CAF50" Margin="10,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#555" FontSize="13"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Обработка..." VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#007ACC"/>
                <ProgressBar IsIndeterminate="True" Width="150" Height="4" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>